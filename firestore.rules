rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPart(part) {
      return part is string && (part == 'PART_1' || part == 'PART_2');
    }

    function isValidSubjectCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 30;
    }

    // 1. StudyNote validation
    function isValidStudyNote(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
             isValidSubjectCode(data.subjectCode) &&
             isValidPart(data.part) &&
             data.isImportant is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 2. StudyTask validation
    function isValidStudyTask(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             isValidSubjectCode(data.subjectCode) &&
             isValidPart(data.part) &&
             data.priority is string && (data.priority == 'HIGH' || data.priority == 'MEDIUM' || data.priority == 'LOW') &&
             data.completed is bool &&
             data.targetDate is string && data.targetDate.size() >= 1 && data.targetDate.size() <= 60 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 3. QuizAttempt validation
    function isValidQuizAttempt(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             isValidSubjectCode(data.subjectCode) &&
             data.subjectTitle is string && data.subjectTitle.size() >= 1 && data.subjectTitle.size() <= 100 &&
             isValidPart(data.part) &&
             data.score is int && data.score >= 0 && data.score <= 100 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100 &&
             data.score <= data.totalQuestions &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 4. CustomFlashcard validation
    function isValidCustomFlashcard(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.question is string && data.question.size() >= 1 && data.question.size() <= 300 &&
             data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 1000 &&
             isValidSubjectCode(data.subjectCode) &&
             isValidPart(data.part) &&
             data.mastered is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'subjectCode', 'part', 'isImportant', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'subjectCode', 'part', 'isImportant', 'createdAt', 'updatedAt']) &&
                         isValidStudyNote(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidStudyNote(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'subjectCode', 'part', 'isImportant', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'title', 'subjectCode', 'part', 'priority', 'completed', 'targetDate', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'subjectCode', 'part', 'priority', 'completed', 'targetDate', 'createdAt', 'updatedAt']) &&
                         isValidStudyTask(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidStudyTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subjectCode', 'part', 'priority', 'completed', 'targetDate', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /quiz_attempts/{attemptId} {
        allow get: if isOwner(userId) && isValidId(attemptId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(attemptId) &&
                         incoming().keys().hasAll(['userId', 'subjectCode', 'subjectTitle', 'part', 'score', 'totalQuestions', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectCode', 'subjectTitle', 'part', 'score', 'totalQuestions', 'createdAt']) &&
                         isValidQuizAttempt(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(attemptId);
      }

      match /flashcards/{cardId} {
        allow get: if isOwner(userId) && isValidId(cardId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(cardId) &&
                         incoming().keys().hasAll(['userId', 'question', 'answer', 'subjectCode', 'part', 'mastered', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'question', 'answer', 'subjectCode', 'part', 'mastered', 'createdAt', 'updatedAt']) &&
                         isValidCustomFlashcard(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(cardId) &&
                         isValidCustomFlashcard(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['question', 'answer', 'subjectCode', 'part', 'mastered', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(cardId);
      }
    }
  }
}
